# Copia este archivo a .env y rellena los valores
#   cp .env.example .env
#
# Este mismo archivo, relleno, es el que se sube a Jenkins como credencial de
# tipo "Secret file" con id pricecloud-env-prod (ver CLAUDE.md).

#--- Despliegue (solo CI/CD, se ignora en local) -----------------------------
# Usuario SSH y ruta del repo en el host Docker donde despliega Jenkins.
# DEPLOY_HOST no se pone aqui: el Jenkinsfile lo detecta solo (gateway de la
# red Docker de Jenkins). En local pueden quedar vacios.
DEPLOY_USER=
DEPLOY_DIR=

#pricecloud-api-01
API_PORT=
API_JWT_SECRET=
API_JWT_EXPIRATION_TIME=
API_COOKIE_EXPIRATION_TIME= # number in ms, required
API_COOKIE_DOMAIN= #default localhost, required Avoid CSRF attacks
ENV=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
COMMON_SECRET= # 32 characters
COMMON_IV= # 16 characters

#pricecloud-db-01
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SECRET= # 32 characters
DB_IV= # 16 characters
TZ=

#pricecloud-ui
# REQUERIDA. Puerto en el que escucha el contenedor. `next start` lo lee via
# PORT, que el compose deriva de aqui, y el health check del pipeline lo lee del
# contenedor. Si falta, el contenedor cae al 3000 por defecto pero el health
# check construye una URL sin puerto y el despliegue falla.
UI_PORT=3000
# REQUERIDA. Host PELADO, sin esquema: el codigo hace `https://${NEXT_PUBLIC_API_HOST}`
# y `wss://${NEXT_PUBLIC_API_HOST}/price` (ver ui/src/helper/customAxios.ts y
# ui/pages/management/console.tsx). Poner "https://api.pricecloud.org" genera
# "https://https://..." y el frontend no llega a la API, sin que el build falle.
# Se congela en el bundle del navegador durante `next build`: cambiarla obliga a
# reconstruir la imagen, no basta con reiniciar el contenedor.
NEXT_PUBLIC_API_HOST=api.pricecloud.org

#pricecloud-api-02
# API02_HOST lo sobreescribe el compose con el nombre del servicio dentro de la
# red Docker; el valor de aqui solo se usa al correr api-01 fuera de Docker.
API02_HOST=
API02_PORT=
INFRACOST_API_KEY=
SELF_HOSTED_INFRACOST_API_KEY=

#pricecloud-db-02
DB2_HOST=
DB2_PORT=
DB2_NAME=
DB2_USER=
DB2_PASSWORD=

#pgadmin (no hay servicio en el compose todavia)
PG_ADMIN_EMAIL=
PG_ADMIN_PASSWORD=
PG_ADMIN_PORT=

#pricecloud-api-03
# Igual que API02_HOST: dentro de Docker lo sobreescribe el compose.
API03_HOST=
API03_PORT=
