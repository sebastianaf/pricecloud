# Copia este archivo a .env y rellena los valores
#   cp .env.example .env
#
# Este mismo archivo, relleno, es el que se sube a Jenkins como credencial de
# tipo "Secret file" con id pricecloud-env-prod (ver CLAUDE.md).

#--- Despliegue (solo CI/CD, se ignora en local) -----------------------------
# Usuario SSH y ruta del repo en el host Docker donde despliega Jenkins.
# DEPLOY_HOST no se pone aqui: el Jenkinsfile lo detecta solo (gateway de la
# red Docker de Jenkins). En local pueden quedar vacios.
DEPLOY_USER=
DEPLOY_DIR=

#--- Compose (OPCIONAL) ------------------------------------------------------
# Los scripts npm (infra, docker:up...) ya pasan
# `-f docker-compose.yml -f docker-compose.local.yml` de forma explicita, asi
# que NO hace falta definir esto para trabajar en local.
#
# Solo sirve si vas a escribir comandos `docker compose ...` a mano y quieres
# que cojan tambien el override local. Ojo, el separador depende del SO:
#   Windows:   COMPOSE_FILE=docker-compose.yml;docker-compose.local.yml
#   Linux/Mac: COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml
#
# Dejarlo comentado es lo mas seguro: un separador equivocado rompe cualquier
# comando docker compose que escribas. En produccion da igual, el Jenkinsfile
# antepone COMPOSE_FILE=docker-compose.yml y eso gana sobre este valor.
#COMPOSE_FILE=docker-compose.yml;docker-compose.local.yml

#pricecloud-api-01
API_PORT=
API_JWT_SECRET=
API_JWT_EXPIRATION_TIME=
API_COOKIE_EXPIRATION_TIME= # number in ms, required
API_COOKIE_DOMAIN= #default localhost, required Avoid CSRF attacks
# local | dev | prod (api-01 lo valida con Joi contra ese enum; 'production' NO
# vale). En la credencial de Jenkins va ENV=prod.
ENV=local
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=
COMMON_SECRET= # 32 characters
COMMON_IV= # 16 characters

#pricecloud-db-01
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SECRET= # 32 characters
DB_IV= # 16 characters
TZ=

#pricecloud-ui
# REQUERIDA. Puerto en el que escucha el contenedor. `next start` lo lee via
# PORT, que el compose deriva de aqui, y el health check del pipeline lo lee del
# contenedor. Si falta, el contenedor cae al 3000 por defecto pero el health
# check construye una URL sin puerto y el despliegue falla.
UI_PORT=3000
# OPCIONAL. Dominio publico del sitio, usado para las URLs canonicas, el
# sitemap, robots.txt y los datos estructurados. Si se omite se usa
# https://pricecloud.org, asi que no hace falta anadirla a la credencial de
# Jenkins salvo que el dominio cambie. Como toda NEXT_PUBLIC_*, se congela en
# el bundle durante `next build`: cambiarla obliga a reconstruir la imagen.
NEXT_PUBLIC_SITE_URL=
# REQUERIDA. Host PELADO, sin esquema: el codigo hace `https://${NEXT_PUBLIC_API_HOST}`
# y `wss://${NEXT_PUBLIC_API_HOST}/price` (ver ui/src/helper/customAxios.ts y
# ui/pages/management/console.tsx). Poner "https://api.pricecloud.org" genera
# "https://https://..." y el frontend no llega a la API, sin que el build falle.
# Se congela en el bundle del navegador durante `next build`: cambiarla obliga a
# reconstruir la imagen, no basta con reiniciar el contenedor.
NEXT_PUBLIC_API_HOST=api.pricecloud.org

#pricecloud-api-02
# API02_HOST lo sobreescribe el compose con el nombre del servicio dentro de la
# red Docker; el valor de aqui solo se usa al correr api-01 fuera de Docker.
API02_HOST=
API02_PORT=
INFRACOST_API_KEY=
SELF_HOSTED_INFRACOST_API_KEY=

#pricecloud-db-02
DB2_HOST=
DB2_PORT=
DB2_NAME=
DB2_USER=
DB2_PASSWORD=

#pgadmin (solo local, via docker-compose.local.yml)
PG_ADMIN_EMAIL=admin@example.com
PG_ADMIN_PASSWORD=
PG_ADMIN_PORT=5050

#pricecloud-api-03
# Igual que API02_HOST: dentro de Docker lo sobreescribe el compose.
API03_HOST=
API03_PORT=
